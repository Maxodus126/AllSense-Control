<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GuardWpfInvariantGlobalization">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllSenseSetup</AssemblyName>
    <RootNamespace>AllSenseSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- GUARD WPF: sama seperti AllSense.App — InvariantGlobalization=true memecah WPF. -->
  <Target Name="GuardWpfInvariantGlobalization">
    <Error Condition="'$(UseWPF)' == 'true' And '$(InvariantGlobalization)' == 'true'"
           Text="InvariantGlobalization=true TIDAK kompatibel dengan WPF/WinForms: font cache WPF gagal (CultureNotFoundException), window tak tampil. Setel InvariantGlobalization=false." />
  </Target>

  <!-- Bangun AllSense.App duluan, lalu embed AllSense.exe sebagai payload internal. -->
  <ItemGroup>
    <ProjectReference Include="..\AllSense.App\AllSense.App.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Payload = hasil PUBLISH AllSense.App (single-file self-contained). -->
  <PropertyGroup>
    <PayloadPath Condition="'$(PayloadPath)' == ''">..\AllSense.App\bin\Release\net10.0-windows10.0.19041.0\win-x64\publish\AllSense.exe</PayloadPath>
    <UninstallPath Condition="'$(UninstallPath)' == ''">..\Uninstall\bin\Release\net10.0-windows\win-x64\publish\Uninstall.exe</UninstallPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" Condition="Exists('$(PayloadPath)')">
      <LogicalName>AllSense.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(UninstallPath)" Condition="Exists('$(UninstallPath)')">
      <LogicalName>Uninstall.exe</LogicalName>
    </EmbeddedResource>
    <ProjectReference Include="..\Uninstall\Uninstall.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
