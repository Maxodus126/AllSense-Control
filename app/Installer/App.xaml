<Application x:Class="AllSenseSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0B0C10"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#13151B"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#1A1E28"/>
        <SolidColorBrush x:Key="LineBrush" Color="#FFFFFF12"/>
        <SolidColorBrush x:Key="FgBrush" Color="#ECEEF3"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#97A0AE"/>
        <SolidColorBrush x:Key="DimBrush" Color="#596272"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4356"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4D8DFF"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#35C973"/>
    </Application.Resources>
</Application>
