<Window x:Class="AllSense.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense Control — Installer" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="24,20,24,20">

        <Grid Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    HorizontalAlignment="Left">
                <TextBlock Text="⚡" FontSize="22" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="54,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AllSense Control" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Instalasi" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <Border Padding="14,12" CornerRadius="12" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Lokasi" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="LocText" Text="…" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource FgBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Versi" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="1.0.0 · x64" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource FgBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Text="Siap menginstal." FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="2,12,0,8"/>

        <ProgressBar x:Name="Progress" Height="6" Maximum="100" Foreground="{StaticResource AccentBlueBrush}"
                     Background="{StaticResource Panel2Brush}" BorderThickness="0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="InstallBtn" Content="Install" Width="110" Height="38" Cursor="Hand"
                    Click="InstallBtn_Click" FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseBtn" Content="Tutup" Width="90" Height="38" Margin="8,0,0,0"
                    Cursor="Hand" Click="CloseBtn_Click" Background="Transparent"
                    Foreground="{StaticResource MutedBrush}" BorderThickness="1"
                    BorderBrush="{StaticResource LineBrush}"/>
        </StackPanel>

    </StackPanel>
</Window>
