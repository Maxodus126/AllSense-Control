<Window x:Class="AllSenseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense Setup" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <StackPanel Margin="28,26,28,26">

        <Grid Margin="0,0,0,6">
            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Left"
                    Background="{StaticResource AccentBrush}" BorderBrush="#66FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <Path Data="M13 2 4.5 13.5H11L9.5 22 19.5 10H13L15.5 2Z"
                      Fill="#0E1017" Stroke="#0E1017" StrokeThickness="1.5"
                      StrokeLineJoin="Round" Stretch="Uniform" Margin="10"/>
            </Border>
            <StackPanel Margin="68,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AllSense Control" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="Setup · v1.0.0 · oleh Maxodus" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Pemasangan akan menyalin aplikasi dan membuat pintasan."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Margin="0,0,0,18"/>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel>
                <TextBlock Text="Lokasi instalasi" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource Panel2Brush}" Foreground="{StaticResource FgBrush}"
                             BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11.5"/>
                    <Button Grid.Column="1" Content="Browse…" Height="34" Margin="8,0,0,0"
                            Cursor="Hand" Padding="14,0" Click="Browse_Click"
                            Foreground="{StaticResource FgBrush}"
                            Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="PERJANJIAN LISENSI" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <ScrollViewer Height="118" VerticalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource FgBrush}" LineHeight="16"
                               Text="AllSense Control dikembangkan oleh Maxodus.&#10;&#10;Dengan memasang perangkat lunak ini, Anda menyetujui:&#10;1. Perangkat lunak disediakan &quot;sebagaimana adanya&quot; tanpa jaminan apa pun.&#10;2. Pengembang tidak bertanggung jawab atas kerusakan langsung maupun tidak langsung akibat penggunaan perangkat lunak ini.&#10;3. Anda boleh menggunakannya untuk keperluan pribadi / non-komersial; dilarang mendistribusikan ulang tanpa izin tertulis.&#10;4. Perangkat lunak hanya memanfaatkan API Windows standar dan tidak mengumpulkan data pribadi."/>
                </ScrollViewer>
                <CheckBox x:Name="LicenseCheck" Content="Saya telah membaca dan menyetujui perjanjian lisensi di atas."
                          Margin="0,10,0,0" Foreground="{StaticResource FgBrush}" FontSize="11"
                          Checked="License_Changed" Unchecked="License_Changed"/>
            </StackPanel>
        </Border>

        <ProgressBar x:Name="Progress" Height="6" Margin="0,18,0,0" Minimum="0" Maximum="100"
                     Foreground="{StaticResource AccentGreenBrush}"
                     Background="{StaticResource Panel2Brush}" BorderThickness="0"
                     Visibility="Collapsed"/>

        <TextBlock x:Name="Status" Height="18" Margin="0,8,0,0" FontSize="11"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TryRun" Content="Jalankan sekarang" Visibility="Collapsed"
                    Click="Run_Click" Cursor="Hand" Height="38" Padding="18,0"
                    Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Foreground="{StaticResource FgBrush}"/>
            <Button Grid.Column="1" x:Name="CloseBtn" Content="Tutup" Visibility="Collapsed"
                    Click="Close_Click" Cursor="Hand" Height="38" Padding="18,0"
                    Background="{StaticResource Panel2Brush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Foreground="{StaticResource FgBrush}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="InstallBtn" Content="Install" Height="38" Padding="26,0"
                    Click="Install_Click" Cursor="Hand"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </Grid>

        <TextBlock Text="Universal · bertenaga daya Windows · tanpa driver vendor"
                   FontSize="10.5" Foreground="{StaticResource DimBrush}"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
