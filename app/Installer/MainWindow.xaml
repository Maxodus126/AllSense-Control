<Window x:Class="AllSenseSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense Setup" Width="560" Height="680"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E242F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBg" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Border Padding="30,26,30,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═ HEADER ═ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}" BorderBrush="#66FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <Path Data="M13 2 4.5 13.5H11L9.5 22 19.5 10H13L15.5 2Z"
                          Fill="#0E1017" Stroke="#0E1017" StrokeThickness="1.5"
                          StrokeLineJoin="Round" Stretch="Uniform" Margin="10"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AllSense Control" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Setup · v2.1.0 · oleh Maxodus" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═ AREA STEP ═ -->
            <Grid Grid.Row="1">

                <!-- ===== STEP 1: LISENSI ===== -->
                <Grid x:Name="StepLicense">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lokasi instalasi" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Height="40" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 Background="{StaticResource Panel2Brush}" Foreground="{StaticResource FgBrush}"
                                 BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="11.5"
                                 TextChanged="PathBox_TextChanged"/>
                        <Button Grid.Column="1" Content="Browse…" Height="40" Margin="8,0,0,0"
                                Cursor="Hand" Padding="16,0" Click="Browse_Click"
                                Foreground="{StaticResource FgBrush}"
                                Background="{StaticResource Panel2Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBg}" Margin="0,16,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PERJANJIAN LISENSI" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                            <ScrollViewer Height="148" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource FgBrush}" LineHeight="17"
                                           Text="AllSense Control dikembangkan oleh Maxodus.&#10;&#10;Dengan memasang perangkat lunak ini, Anda menyetujui:&#10;1. Perangkat lunak disediakan &quot;sebagaimana adanya&quot; tanpa jaminan apa pun.&#10;2. Pengembang tidak bertanggung jawab atas kerusakan langsung maupun tidak langsung akibat penggunaan perangkat lunak ini.&#10;3. Anda boleh menggunakannya untuk keperluan pribadi / non-komersial; dilarang mendistribusikan ulang tanpa izin tertulis.&#10;4. Perangkat lunak hanya memanfaatkan API Windows standar dan tidak mengumpulkan data pribadi."/>
                            </ScrollViewer>
                            <CheckBox x:Name="LicenseCheck" Content="Saya telah membaca dan menyetujui perjanjian lisensi di atas."
                                      Margin="0,12,0,0" Foreground="{StaticResource FgBrush}" FontSize="11"
                                      Checked="License_Changed" Unchecked="License_Changed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UpStatus" Grid.Row="4" Margin="0,12,0,0" FontSize="11.5"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text=""/>
                    <TextBlock Grid.Row="5" Text=""/>

                    <Grid Grid.Row="6" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelBtn" Content="Batal" Click="Cancel_Click"
                                Style="{StaticResource BtnGhost}"/>
                        <Button Grid.Column="1" x:Name="NextBtn" Content="Lanjutkan" Margin="10,0,0,0"
                                Click="Next_Click" Style="{StaticResource BtnPrimary}" IsEnabled="False"/>
                    </Grid>
                </Grid>

                <!-- ===== STEP 2: KONFIRMASI ===== -->
                <Grid x:Name="StepConfirm" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ringkasan pemasangan" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Text="AllSense Control akan dipasang ke:" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/>

                    <Border Grid.Row="2" Style="{StaticResource CardBg}" Padding="14,12">
                        <TextBlock x:Name="ConfirmPath" Style="{StaticResource Mono}"
                                   Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource CardBg}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Yang akan dikerjakan:" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="✔  Menyalin aplikasi utama (AllSense.exe)" FontSize="11.5"
                                       Foreground="{StaticResource FgBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="✔  Membuat pintasan Desktop &amp; Start Menu" FontSize="11.5"
                                       Foreground="{StaticResource FgBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="✔  Menyertakan uninstaller &amp; mendaftarkannya di Apps &amp; Features"
                                       FontSize="11.5" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StepMsg" Grid.Row="4" Margin="0,12,0,0" FontSize="11.5"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text=""/>

                    <Grid Grid.Row="5" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Kembali" Click="Back_Click" Style="{StaticResource BtnGhost}"/>
                        <Button Grid.Column="1" Content="Pasang" Margin="10,0,0,0"
                                Click="GoInstall_Click" Style="{StaticResource BtnPrimary}" Padding="30,0"/>
                    </Grid>
                </Grid>

                <!-- ===== STEP 3: PROGRES ===== -->
                <Grid x:Name="StepProgress" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1" Text="Memasang AllSense Control…" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <ProgressBar x:Name="InstallProgress" Grid.Row="2" Height="8" Minimum="0" Maximum="100"
                                 Value="0" Foreground="{StaticResource AccentGreenBrush}"
                                 Background="{StaticResource Panel2Brush}" BorderThickness="0"/>
                    <TextBlock x:Name="InstallStatus" Grid.Row="3" Margin="0,12,0,0" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Text=""/>
                </Grid>

                <!-- ===== STEP 4: SELESAI ===== -->
                <Grid x:Name="StepDone" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                            Background="#1735C973" BorderBrush="#5935C973" BorderThickness="1">
                        <Path Data="M12 4 6 12l-3-3" Stretch="Uniform" Margin="20"
                              Stroke="{StaticResource AccentGreenBrush}" StrokeThickness="3.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Pemasangan selesai" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock x:Name="DoneStatus" Grid.Row="3" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Text=""/>

                    <Grid Grid.Row="4" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TryRun" Content="Jalankan sekarang" Click="Run_Click"
                                Style="{StaticResource BtnGhost}" HorizontalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="CloseBtn" Content="Tutup" Margin="10,0,0,0"
                                Click="Close_Click" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
