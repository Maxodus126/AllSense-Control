<Window x:Class="AllSense.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense"
        Width="240" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Geometry x:Key="gBattery">M3 7.5h16v9H3ZM22 10.5v3</Geometry>
        <Style x:Key="Ic" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="14" Padding="1"
            Background="{StaticResource Line2Brush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="13" ClipToBounds="True"
                Background="{StaticResource CardBrush}">
            <StackPanel Orientation="Horizontal" Margin="12,10,12,10">
                <Border Width="26" Height="26" CornerRadius="8" BorderThickness="1"
                        Background="{StaticResource RedSoftBrush}"
                        BorderBrush="{StaticResource RedLineBrush}">
                    <Viewbox Width="13" Height="13">
                        <Path Data="{StaticResource gBattery}" Style="{StaticResource Ic}"
                              Stroke="{StaticResource RedBrush}"/>
                    </Viewbox>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleBlock" Text="Peringatan"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource LabelBrush}"/>
                    <TextBlock x:Name="BodyBlock" Text="Baterai rendah"
                               FontSize="11.5" Foreground="{StaticResource FgBrush}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               MaxWidth="170"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>