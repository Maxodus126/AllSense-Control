<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GuardWpfInvariantGlobalization">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllSense</AssemblyName>
    <RootNamespace>AllSense</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- InvariantGlobalization TIDAK bisa dipakai utk WPF: font cache (MajorLanguages)
         butuh data budaya nyata; mode invariant → CultureNotFoundException → window tak pernah muncul.
         Wajib false, biarpun exe lebih besar (~+30MB ICU). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- GUARD WPF: InvariantGlobalization=true membuang data budaya → font cache WPF
       (MS.Internal.FontCache.MajorLanguages) lempar CultureNotFoundException → window tak pernah tampil.
       Error MSBuild ini memaksa build gagal bila flag berbahaya ini diaktifkan. -->
  <Target Name="GuardWpfInvariantGlobalization">
    <Error Condition="'$(UseWPF)' == 'true' And '$(InvariantGlobalization)' == 'true'"
           Text="InvariantGlobalization=true TIDAK kompatibel dengan WPF/WinForms: mode invariant membuang data budaya, font cache WPF gagal render window (CultureNotFoundException), app tampil diam-diam. Setel InvariantGlobalization=false (bukan true)." />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
