                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- FOOTER -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
