                                                  Stroke="{StaticResource GreenBrush}"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Style="{StaticResource SecTitle}"
                                               Text="Status perangkat"/>
                                </StackPanel>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="13" Height="13"
                                             VerticalAlignment="Center">
                                        <Path Data="{StaticResource gBattery}" Style="{StaticResource Ic}"
                                              Stroke="{StaticResource DimBrush}"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}"
                                               Text="Baterai"/>
