                                        <TextBlock Text="Ctrl+Alt+A" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="ctrl+shift+a"
                                            MouseLeftButtonDown="TogglePreset_Click">
                                        <TextBlock Text="Ctrl+Shift+A"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="alt+home"
                                            MouseLeftButtonDown="TogglePreset_Click">
                                        <TextBlock Text="Alt+Home" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="ctrl+f11"
                                            MouseLeftButtonDown="TogglePreset_Click">
                                        <TextBlock Text="Ctrl+F11" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                </WrapPanel>

