<Window x:Class="AllSense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense Control" Width="416" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- IKON -->
        <Geometry x:Key="gBolt">M13 2 4.5 13.5H11L9.5 22 19.5 10H13L15.5 2Z</Geometry>
        <Geometry x:Key="gPower">M12 3v8M6.4 6.6a8 8 0 1 0 11.2 0</Geometry>
        <Geometry x:Key="gWave">M4 12.5h3l2-6.5 3 12 2.2-5.5H20</Geometry>
        <Geometry x:Key="gFast">M5 15 12 8l7 7M5 20l7-7 7 7</Geometry>
        <Geometry x:Key="gSun">M12 7.8a4.2 4.2 0 1 0 0 8.4 4.2 4.2 0 0 0 0-8.4ZM12 2.5v2.4M12 19.1v2.4M21.5 12h-2.4M4.9 12H2.5M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7M18.8 18.8l-1.7-1.7M6.9 6.9 5.2 5.2</Geometry>
        <Geometry x:Key="gSpeaker">M11 5 6 9H3v6h3l5 4V5ZM15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12</Geometry>
        <Geometry x:Key="gSpeakerMute">M11 5 6 9H3v6h3l5 4V5Z</Geometry>
        <Geometry x:Key="gWifi">M2.5 8.5a15 15 0 0 1 19 0M5.5 12a11 11 0 0 1 13 0M8.5 15.5a7 7 0 0 1 7 0M12 19a1.3 1.3 0 1 1 0.01 0</Geometry>
        <Geometry x:Key="gBt">M6.5 7.5 17.5 16.5 12 21V3l5.5 4.5-11 9</Geometry>
        <Geometry x:Key="gMonitor">M3 4.5h18v12.5H3ZM8.5 21h7M12 17v4</Geometry>
        <Geometry x:Key="gBattery">M3 7.5h16v9H3ZM22 10.5v3</Geometry>
        <Geometry x:Key="gGear">M12 8.75a3.25 3.25 0 1 0 0 6.5 3.25 3.25 0 0 0 0-6.5ZM19.4 15a1.6 1.6 0 0 0 .32 1.77l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-.97 1.47V21a2 2 0 1 1-4 0v-.09a1.6 1.6 0 0 0-1.05-1.47 1.6 1.6 0 0 0-1.77.32l-.06.06a2 2 0 1 1-2.83-2.83l.06.06a1.6 1.6 0 0 0 .32-1.77 1.6 1.6 0 0 0-1.47-.97H3a2 2 0 1 1 0-4h.09a1.6 1.6 0 0 0 1.47-1.05 1.6 1.6 0 0 0-.32-1.77l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.6 1.6 0 0 0 1.77.32h.02a1.6 1.6 0 0 0 1.05-1.47V3a2 2 0 1 1 4 0v.09a1.6 1.6 0 0 0 .97 1.47h.02a1.6 1.6 0 0 0 1.77-.32l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.6 1.6 0 0 0-.32 1.77v.02a1.6 1.6 0 0 0 1.47.97H21a2 2 0 1 1 0 4h-.09a1.6 1.6 0 0 0-1.51 1.05Z</Geometry>
        <Geometry x:Key="gX">M6 6l12 12M18 6 6 18</Geometry>
        <Geometry x:Key="gMin">M5 12h14</Geometry>

        <Style x:Key="Ic" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <!-- KARTU -->
        <Style x:Key="CardSolid" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="12,11,12,10"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- JUDUL -->
        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SecTail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- ROW -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="29"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        </Style>

        <!-- MODE TILE -->
        <Style x:Key="ModeTile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="2.5,0"/>
            <Setter Property="Padding" Value="2,8,2,7"/>
        </Style>

        <!-- SLIDER: track 6px, thumb 18px, tidak terpotong -->
        <Style x:Key="SliderBase" TargetType="Slider">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" VerticalAlignment="Center" Background="Transparent">
                            <Border Height="6" CornerRadius="3"
                                    Background="{StaticResource TrackBrush}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3"
                                                        Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" ClipToBounds="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18" ClipToBounds="False">
                                                    <!-- thumb tanpa DropShadowEffect (blur per-frame saat drag) -->
                                                    <Ellipse Width="18" Height="18" Fill="#FFF7F9FC"
                                                             Stroke="#66FFFFFF" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MUTE BUTTON -->
        <Style x:Key="MuteBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="6" Background="#0AFFFFFF"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <Viewbox Width="11" Height="11">
                                    <Path x:Name="spk" Data="{StaticResource gSpeakerMute}"
                                          Style="{StaticResource Ic}" Stroke="{StaticResource MutedBrush}"/>
                                </Viewbox>
                                <Path x:Name="slash" Data="M2.5 2.5L21.5 21.5"
                                      Stroke="{StaticResource RedBrush}" StrokeThickness="2"
                                      Opacity="0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="slash" Property="Opacity" Value="1"/>
                                <Setter TargetName="spk" Property="Stroke" Value="{StaticResource RedBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RedSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource RedLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MINI BUTTON -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{StaticResource CardHiBrush}"
                                BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniBtnPrimary" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Foreground" Value="#FFEAF0FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{StaticResource BlueSoftBrush}"
                                BorderBrush="{StaticResource BlueLineBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#294D8DFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHIP -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0FFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- PILL -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Fill" Value="{StaticResource DimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- KBD -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TILE -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#07FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0EFFFFFF"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="GrpTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Margin" Value="3,0,0,5"/>
        </Style>

        <!-- SWITCH -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="33"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Width="33" Height="19" CornerRadius="10"
                                Background="{StaticResource TrackBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="#FFE9EDF5"
                                     HorizontalAlignment="Left" Margin="1.5,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                                      Opacity="0.5" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource GreenBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8C35C973"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment"
                                        Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,1.5,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- SHELL -->
    <!-- Tanpa DropShadowEffect besar: software blur di-render ulang tiap invalidasi
         (slider/mode/update teks tiap 2 dtk). Kedalaman dijaga lewat border + gradien. -->
    <Border Margin="10" CornerRadius="20" Padding="1" Background="{StaticResource Line2Brush}">
        <Border CornerRadius="19" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF0C0E14" Offset="0"/>
                    <GradientStop Color="#FF090A0F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,14,14,12">

                        <!-- HEADER -->
                        <Grid x:Name="DragBar" Background="Transparent" Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="36" Height="36" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{StaticResource Line2Brush}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF2A2E3B" Offset="0"/>
                                        <GradientStop Color="#FF111319" Offset="0.7"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource gBolt}" Style="{StaticResource Ic}"
                                          Stroke="{StaticResource RedBrush}" Fill="{StaticResource RedBrush}">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                              Opacity="0.75" Color="#FFFF4356"/>
                                        </Path.Effect>
                                    </Path>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AllSense Control" FontSize="14.5"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock x:Name="VersionChip" Style="{StaticResource ChipText}"
                                                   Text="v2.0.0"/>
                                    </Border>
                                    <Border x:Name="AcChip" Style="{StaticResource Chip}"
                                            Margin="5,0,0,0"
                                            Background="{StaticResource GreenSoftBrush}"
                                            BorderBrush="{StaticResource GreenLineBrush}">
                                        <TextBlock x:Name="AcText" Style="{StaticResource ChipText}"
                                                   Text="AC · 100%"
                                                   Foreground="{StaticResource GreenBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostBtn}" ToolTip="Pengaturan"
                                        Click="SettingsBtn_Click">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource gGear}" Style="{StaticResource Ic}"
                                              Stroke="{StaticResource MutedBrush}"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource GhostBtn}" ToolTip="Minimalkan"
                                        Margin="4,0,0,0" Click="MinBtn_Click">
                                    <Viewbox Width="13" Height="13">
                                        <Path Data="{StaticResource gMin}" Style="{StaticResource Ic}"
                                              Stroke="{StaticResource MutedBrush}"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource GhostBtn}" ToolTip="Tutup"
                                        Margin="4,0,0,0" Click="HeaderClose_Click">
                                    <Viewbox Width="13" Height="13">
                                        <Path Data="{StaticResource gX}" Style="{StaticResource Ic}"
                                              Stroke="{StaticResource MutedBrush}"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- MODE DAYA -->
                        <Border Style="{StaticResource CardSolid}">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="21" Height="21" CornerRadius="6"
                                                BorderThickness="1"
                                                Background="{StaticResource RedSoftBrush}"
                                                BorderBrush="{StaticResource RedLineBrush}">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="{StaticResource gBolt}"
                                                      Style="{StaticResource Ic}"
                                                      Stroke="{StaticResource RedBrush}"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Style="{StaticResource SecTitle}" Text="Mode daya"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SecTail}" Text="POWER MODE"/>
                                </Grid>

                                <Border CornerRadius="10" Background="{StaticResource InsetBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        Padding="3">
                                    <UniformGrid Columns="3">
                                        <Border x:Name="bdE" Tag="efficiency"
                                                Style="{StaticResource ModeTile}"
                                                MouseLeftButtonDown="Mode_Click">
                                            <StackPanel>
                                                <Viewbox Width="16" Height="16" Margin="0,0,0,4"
                                                         HorizontalAlignment="Center">
                                                    <Path x:Name="EIcon" Data="{StaticResource gPower}"
                                                          Style="{StaticResource Ic}"/>
                                                </Viewbox>
                                                <TextBlock x:Name="ECap" Text="Hemat" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="ESub" Text="EFFICIENCY" FontSize="8.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="bdB" Tag="balanced"
                                                Style="{StaticResource ModeTile}"
                                                MouseLeftButtonDown="Mode_Click">
                                            <StackPanel>
                                                <Viewbox Width="16" Height="16" Margin="0,0,0,4"
                                                         HorizontalAlignment="Center">
                                                    <Path x:Name="BIcon" Data="{StaticResource gWave}"
                                                          Style="{StaticResource Ic}"/>
                                                </Viewbox>
                                                <TextBlock x:Name="BCap" Text="Seimbang" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="BSub" Text="BALANCED" FontSize="8.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="bdP" Tag="performance"
                                                Style="{StaticResource ModeTile}"
                                                MouseLeftButtonDown="Mode_Click">
                                            <StackPanel>
                                                <Viewbox Width="16" Height="16" Margin="0,0,0,4"
                                                         HorizontalAlignment="Center">
                                                    <Path x:Name="PIcon" Data="{StaticResource gFast}"
                                                          Style="{StaticResource Ic}"/>
                                                </Viewbox>
                                                <TextBlock x:Name="PCap" Text="Turbo" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="PSub" Text="PERFORMANCE" FontSize="8.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- TAMPILAN & SUARA -->
                        <Border Style="{StaticResource CardSolid}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="21" Height="21" CornerRadius="6" BorderThickness="1"
                                            Background="{StaticResource BlueSoftBrush}"
                                            BorderBrush="{StaticResource BlueLineBrush}">
                                        <Viewbox Width="12" Height="12">
                                            <Path Data="{StaticResource gMonitor}"
                                                  Style="{StaticResource Ic}"
                                                  Stroke="{StaticResource BlueBrush}"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Style="{StaticResource SecTitle}" Text="Tampilan &amp; suara"/>
                                </StackPanel>

                                <!-- Kecerahan: label+value satu baris, slider penuh di bawah -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="14" Height="14"
                                             VerticalAlignment="Center">
                                        <Path Data="{StaticResource gSun}" Style="{StaticResource Ic}"
                                              Stroke="{StaticResource DimBrush}"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Kecerahan" FontSize="12.5"
