                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ResText" Text="1920 × 1200"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Text="   " FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5"/>
