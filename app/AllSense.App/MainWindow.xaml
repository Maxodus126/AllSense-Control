                                                           Foreground="{StaticResource LabelBrush}"/>
                                                <TextBlock Text="Tombol minus menyembunyikan panel ke system tray"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="ChkTray"
                                                          Style="{StaticResource Switch}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Click="ChkTray_Click"/>
