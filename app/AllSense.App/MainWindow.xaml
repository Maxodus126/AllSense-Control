                                                    VerticalAlignment="Center" Style="{StaticResource Kbd}"
                                                    MouseLeftButtonDown="HKRecord_Click" Tag="1"
                                                    ToolTip="Klik lalu tekan kombinasi baru">
                                                <TextBlock x:Name="HKLabelA" Text="Ctrl+Alt+A" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
