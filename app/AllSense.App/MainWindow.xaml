                                        Margin="0,0,5,0" Padding="5,1" BorderThickness="1">
                                    <TextBlock x:Name="HKFootM" Text="Ctrl+Alt+M"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                                <TextBlock Text="mode" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

