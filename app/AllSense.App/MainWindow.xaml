                                                           Foreground="{StaticResource DimBrush}"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="ChkAutoBat"
                                                          Style="{StaticResource Switch}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Click="ChkAutoBat_Click"
                                                          ToolTip="Saat colokan dicabut: pindah otomatis ke Hemat. Saat dicolok ulang: pulihkan mode semula."/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid MinHeight="42">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="Jalankan saat startup" FontSize="12.5"
                                                           Foreground="{StaticResource LabelBrush}"/>
                                                <TextBlock Text="Hotkey tetap aktif walau panel disembunyikan"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
