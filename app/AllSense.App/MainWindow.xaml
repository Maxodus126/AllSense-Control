                                                         FontFamily="{StaticResource MonoFont}"
                                                         Background="{StaticResource InsetBrush}"
                                                         Foreground="{StaticResource FgBrush}"
                                                         BorderBrush="{StaticResource Line2Brush}"
                                                         BorderThickness="1" KeyDown="BatWarn_KeyDown"
                                                         ToolTip="Bubble tray saat % baterai ≤ ambang ini (5–100)"/>
