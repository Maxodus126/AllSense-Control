                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="alt+end"
                                            MouseLeftButtonDown="CyclePreset_Click">
                                        <TextBlock Text="Alt+End" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="ctrl+f9"
