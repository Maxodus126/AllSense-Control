                                <Border Style="{StaticResource RowDivider}"/>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="13" Height="13"
                                             VerticalAlignment="Center">
                                        <Path Data="{StaticResource gWifi}" Style="{StaticResource Ic}"
