                                            <TextBlock Text="Versi" FontSize="12.5"
                                                       Foreground="{StaticResource LabelBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutVersion" Text="2.0.0"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource FgBrush}"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>
