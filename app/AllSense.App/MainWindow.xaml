                                            <ToggleButton x:Name="ChkStartup"
                                                          Style="{StaticResource Switch}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Click="ChkStartup_Click"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid MinHeight="42">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
