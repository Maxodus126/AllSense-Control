<Window x:Class="AllSense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AllSense"
        Title="AllSense Control" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <!-- Kartu -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12,14,13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Mode selector (toggle) -->
        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           LineHeight="13"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#101B32"/>
                                <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource FgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- toggle ikon wifi/bluetooth -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                TextElement.Foreground="{StaticResource DimBrush}"
                                CornerRadius="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentPresenter x:Name="ic" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse x:Name="dot" Width="5" Height="5" Margin="0,2,5,0"
                                             Fill="{StaticResource DimBrush}"/>
                                    <TextBlock x:Name="st" Text="Off" FontSize="9"
                                               FontWeight="Bold" Foreground="{StaticResource DimBrush}"
                                              />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                <Setter TargetName="st" Property="Text" Value="ON"/>
                                <Setter TargetName="st" Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider kustom -->
        <Style x:Key="ASlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Height="5">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  Command="Slider.DecreaseLarge">
                                        <RepeatButton.Background>
                                            <SolidColorBrush x:Name="fillBrush" Color="#FFB020"/>
                                        </RepeatButton.Background>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}" Command="Slider.IncreaseLarge"
                                                  Background="#262B37"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F5F7FB">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                                          Opacity="0.5" Color="#FFB020"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- ══ TAMPILAN UTAMA ══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,14">

                <!-- header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                            Background="#1A1E28" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AllSense Control" FontSize="15" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Margin="0,0,5,0" Padding="6,1,6,1" CornerRadius="8"
                                    Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="v1.0.0" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <Border x:Name="AcChip" Padding="6,1,6,1" CornerRadius="8"
                                    Background="#0F2016" BorderBrush="#35C97344" BorderThickness="1">
                                <TextBlock x:Name="AcText" Text="AC" FontSize="9.5"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="SettingsBtn" Width="32" Height="32"
                            Content="⚙" FontSize="15" Cursor="Hand"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Click="SettingsBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- baterai -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="8" Background="#0F2016"
                                BorderBrush="#35C97344" BorderThickness="1">
                            <TextBlock Text="🔋" FontSize="14" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Baterai" FontSize="10" Foreground="{StaticResource DimBrush}"
                                      />
                            <TextBlock x:Name="BatteryText" Text="—" FontSize="15"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{StaticResource FgBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- performance -->
                <Border Style="{StaticResource Card}" BorderBrush="#FF435644">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SecTitle}" Text="PERFORMANCE"/>
                            <TextBlock Style="{StaticResource Val}" FontSize="10"
                                       HorizontalAlignment="Right" Text="POWER MODE"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ToggleButton x:Name="ModeE" Style="{StaticResource ModeToggle}"
                                          Content="Best Efficiency" Margin="0,0,7,0"
                                          Click="Mode_Click" Tag="efficiency"/>
                            <ToggleButton x:Name="ModeB" Style="{StaticResource ModeToggle}"
                                          Content="Balanced" IsChecked="True"
                                          Margin="0,0,7,0" Click="Mode_Click" Tag="balanced"/>
                            <ToggleButton x:Name="ModeP" Style="{StaticResource ModeToggle}"
                                          Content="Best Performance" Click="Mode_Click"
                                          Tag="performance"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- koneksi + screen -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,6,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SecTitle}" Text="KONEKSI"/>
                            </Grid>
                            <UniformGrid Columns="2" Rows="1">
                                <ToggleButton x:Name="WifiToggle" Style="{StaticResource IconToggle}"
                                              Margin="0,0,4,0">
                                    <TextBlock Text="📶" FontSize="20"/>
                                </ToggleButton>
                                <ToggleButton x:Name="BtToggle" Style="{StaticResource IconToggle}"
                                              Margin="4,0,0,0">
                                    <TextBlock Text="🅱️" FontSize="18"/>
                                </ToggleButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SecTitle}" Text="SCREEN"/>
                            </Grid>
                            <Grid>
                                <TextBlock Style="{StaticResource Lbl}" Text="Refresh Rate"/>
                                <TextBlock x:Name="RefreshText" Style="{StaticResource Val}"
                                           HorizontalAlignment="Right" Text="240 Hz"/>
                            </Grid>
                            <Border Margin="0,8,0,0" Padding="0,8,0,0"
                                    BorderBrush="#FFFFFF0D" BorderThickness="0,1,0,0">
                                <Grid>
                                    <TextBlock Text="Resolusi" FontSize="10"
                                               Foreground="{StaticResource DimBrush}"/>
                                    <TextBlock x:Name="ResText" Text="1920 × 1200" FontSize="10"
                                               FontFamily="Consolas" HorizontalAlignment="Right"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- tampilan & suara -->
                <Border Style="{StaticResource Card}" BorderBrush="#FFB02044">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SecTitle}" Text="TAMPILAN &AMP; SUARA"/>
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="🔆 Brightness" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="BrightVal" HorizontalAlignment="Right" FontSize="17"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{StaticResource FgBrush}" Text="75%"/>
                        </Grid>
                        <Slider x:Name="BrightSlider" Style="{StaticResource ASlider}"
                                Minimum="10" Maximum="100" Value="75"
                                ValueChanged="BrightSlider_ValueChanged"/>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="🔊 Volume" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="VolVal" HorizontalAlignment="Right" FontSize="17"
                                       FontFamily="Consolas" FontWeight="SemiBold"
                                       Foreground="{StaticResource FgBrush}" Text="65%"/>
                        </Grid>
                        <Slider x:Name="VolSlider" Style="{StaticResource ASlider}"
                                Minimum="0" Maximum="100" Value="65"
                                ValueChanged="VolSlider_ValueChanged"/>

                        <CheckBox x:Name="MuteBox" Content="Mute" Margin="0,8,0,0"
                                  FontSize="12" Foreground="{StaticResource MutedBrush}"
                                  Checked="Mute_Changed" Unchecked="Mute_Changed"/>
                    </StackPanel>
                </Border>

                <Button x:Name="ExitBtn" Height="42" Cursor="Hand" Click="ExitBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="12">
                                <TextBlock Text="Keluar" Foreground="{StaticResource MutedBrush}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A1213"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF435655"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="UNIVERSAL · TANPA ADMIN · POWER MODE WINDOWS"
                           FontSize="9.5" Foreground="{StaticResource DimBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                          />
            </StackPanel>
        </ScrollViewer>

        <!-- ══ OVERLAY SETTINGS ══ -->
        <Grid x:Name="Overlay" Visibility="Collapsed">
            <Border Background="#8A05060A" MouseLeftButtonDown="Overlay_Click"/>
            <Border x:Name="Sheet" Width="330" HorizontalAlignment="Right" Background="#12151D"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <StackPanel Margin="20,16,20,16">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="⚙ PENGATURAN" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"
                                  />
                        <Button x:Name="SheetClose" HorizontalAlignment="Right" Content="✕"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource MutedBrush}" FontSize="13"
                                Click="SheetClose_Click"/>
                    </Grid>

                    <TextBlock Text="SHORTCUT" FontSize="9.5" FontWeight="Bold"
                               Foreground="{StaticResource DimBrush}"
                               Margin="0,0,0,8"/>
                    <Border Padding="10,9" CornerRadius="9" Background="{StaticResource Panel2Brush}"
                            Margin="0,0,0,5">
                        <Grid>
                            <TextBlock Text="Buka / Tutup window" Style="{StaticResource Lbl}"/>
                            <Border HorizontalAlignment="Right" Padding="8,2" CornerRadius="6"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="Ctrl+Alt+A" FontSize="10.5" FontFamily="Consolas"
                                           Foreground="{StaticResource FgBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Padding="10,9" CornerRadius="9" Background="{StaticResource Panel2Brush}"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Ganti mode" Style="{StaticResource Lbl}"/>
                            <Border HorizontalAlignment="Right" Padding="8,2" CornerRadius="6"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="Ctrl+Alt+M" FontSize="10.5" FontFamily="Consolas"
                                           Foreground="{StaticResource FgBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="ABOUT" FontSize="9.5" FontWeight="Bold"
                               Foreground="{StaticResource DimBrush}"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Lbl}" Text="Versi"/>
                        <TextBlock Style="{StaticResource Val}" HorizontalAlignment="Right" Text="1.0.0"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Lbl}" Text="Build"/>
                        <TextBlock Style="{StaticResource Val}" HorizontalAlignment="Right" Text="26100"/>
                    </Grid>
                    <Grid>
                        <TextBlock Style="{StaticResource Lbl}" Text="Selftest"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="OK" Foreground="{StaticResource AccentGreenBrush}"
                                       FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
