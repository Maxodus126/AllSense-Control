                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="CheckBtn" Content="Cek"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Style="{StaticResource MiniBtn}"
                                                    Click="CheckUpdate_Click"/>
                                        </Grid>
                                        <Border Style="{StaticResource RowDivider}"/>
                                        <Grid MinHeight="34">
                                            <TextBlock x:Name="UpStatus" Text="Siap memeriksa"
                                                       FontSize="12.5"
                                                       Foreground="{StaticResource LabelBrush}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Margin="0,0,8,0"/>
                                            <Button x:Name="DlBtn" Content="Unduh"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MiniBtnPrimary}"
                                                    Click="DlBtn_Click"/>
                                        </Grid>
                                        <ProgressBar x:Name="UpProgress" Height="4" Margin="0,2,0,6"
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Visibility="Collapsed"
                                                     Foreground="{StaticResource BlueBrush}"
                                                     Background="{StaticResource TrackBrush}"
                                                     BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource GrpTitle}" Text="SISTEM"/>
