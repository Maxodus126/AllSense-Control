                                        <TextBlock Text="Ctrl+F9" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Kbd}" Margin="0,0,4,4"
                                            Padding="6,1" BorderThickness="1" Tag="ctrl+alt+t"
                                            MouseLeftButtonDown="CyclePreset_Click">
                                        <TextBlock Text="Ctrl+Alt+T"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"/>
                                    </Border>
                                </WrapPanel>

                                <Grid Margin="0,2,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
