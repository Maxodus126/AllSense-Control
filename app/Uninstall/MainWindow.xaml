<Window x:Class="AllSenseUninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllSense Uninstall" Width="480" Height="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF0E1017" Foreground="#FFEEF0F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBg" TargetType="Border">
            <Setter Property="Background" Value="#FF161A23"/>
            <Setter Property="BorderBrush" Value="#21FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Padding="30,26,30,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="#FF161A23"
                        BorderBrush="#21FFFFFF" BorderThickness="1">
                    <Path Data="M13 2 4.5 13.5H11L9.5 22 19.5 10H13L15.5 2Z"
                          Fill="#FFFF4356" Stretch="Uniform" Margin="11"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AllSense Control" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Uninstaller" FontSize="12" Foreground="#FF97A0AE" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- DESKRIPSI -->
            <TextBlock Grid.Row="1" Text="Hapus pemasangan AllSense Control dari komputer ini?"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <!-- APA YANG DIHAPUS -->
            <Border Grid.Row="2" Style="{StaticResource CardBg}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Yang akan dihapus:" FontSize="10.5" FontWeight="Bold"
                               Foreground="#FF97A0AE" Margin="0,0,0,10"/>
                    <TextBlock Text="✔  Folder program AllSense" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="✔  Data pengaturan (APPDATA\AllSense)" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="✔  Pintasan Desktop &amp; Start Menu" FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="✔  Autostart &amp; entri Apps &amp; Features" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Status" Grid.Row="3" Margin="0,12,0,0" FontSize="11.5"
                       Foreground="#FFFF4356" TextWrapping="Wrap" Text=""/>

            <!-- TOMBOL -->
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelBtn" Content="Batal" Click="Cancel_Click"
                        Style="{StaticResource BtnBase}" Background="#FF161A23"
                        BorderBrush="#21FFFFFF" Foreground="#FFEEF0F5"/>
                <Button Grid.Column="1" x:Name="GoBtn" Content="Hapus Pemasangan" Margin="10,0,0,0"
                        Click="Go_Click" Style="{StaticResource BtnBase}"
                        Background="#FFFF4356" BorderThickness="0" Foreground="White"
                        FontWeight="SemiBold" Padding="26,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
